# --- Required: Anthropic API key for the browser-use agent ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional: model + path overrides ---
SOCIAL_AGENTS_MODEL=claude-sonnet-4-6
SOCIAL_AGENTS_PROFILES_DIR=
SOCIAL_AGENTS_MEDIA_DIR=

# --- Per-account credentials (optional, future automated re-login) ---
# Format: <PLATFORM>_<ACCOUNT_LABEL>_USERNAME / _PASSWORD
# The default flow is manual login (`social-agents login ...`) which persists
# Chrome profile to disk. Credentials below are read only if you opt into
# automated re-login when a session is invalidated.
#
# INSTAGRAM_ADAM_USERNAME=
# INSTAGRAM_ADAM_PASSWORD=
# INSTAGRAM_THROWAWAY_USERNAME=
# INSTAGRAM_THROWAWAY_PASSWORD=
# TIKTOK_ADAM_USERNAME=
# TIKTOK_ADAM_PASSWORD=
# LINKEDIN_ADAM_USERNAME=
# LINKEDIN_ADAM_PASSWORD=
# TWITTER_ADAM_USERNAME=
# TWITTER_ADAM_PASSWORD=

# --- Daily-devotional pipeline ---
SOCIAL_AGENTS_IG_ACCOUNT=adam
