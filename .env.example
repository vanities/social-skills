# social-agents — environment configuration.
#
# Copy this file to .env and fill in the values for the platforms you'll use.
# .env is git-ignored. Skills read it via grep|cut (NOT source) so passwords
# with shell-special chars ($, backtick, single-quote) are safe.

# --- Daily-devotional pipeline ---
SOCIAL_AGENTS_IG_ACCOUNT=swiftbible

# --- Instagram (per-account credentials) ---
# Convention: INSTAGRAM_<ACCOUNT_LABEL>_USERNAME / _PASSWORD.
# The account label is what you pass to /instagram-login <account> and is
# the directory name under ~/.config/agent-browser/instagram-<label>.json.
INSTAGRAM_SWIFTBIBLE_USERNAME=
INSTAGRAM_SWIFTBIBLE_PASSWORD=

# --- LinkedIn (single account, no label split) ---
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=

# --- X / Twitter (single account, no label split) ---
# Username can be handle, email, or phone — X accepts any on the first screen.
TWITTER_USERNAME=
TWITTER_PASSWORD=

# --- Pinterest (single account, no label split) ---
PINTEREST_USERNAME=
PINTEREST_PASSWORD=

# --- TikTok (manual login only) ---
# TikTok web sign-in has aggressive CAPTCHAs / slider puzzles even from real
# Chrome. Auto-login isn't worth attempting; sign in by hand once and the
# saved state at ~/.config/agent-browser/tiktok-default.json keeps you logged in.

# --- Browser overrides (rarely needed) ---
# SOCIAL_AGENTS_CHROME_PROFILE=~/.social-agents/chrome-profile
# SOCIAL_AGENTS_CHROME_BINARY=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# DO NOT add ANTHROPIC_API_KEY here — Claude Code (OAuth via your subscription)
# IS the agent. There is no API key in this stack.
